# ベクターDB反映待ち時間 (ミリ秒, 任意, デフォルト: 90000 = 90秒)
NOTIFY_INTERVAL_MS=90000

# Axiom ログ送信 (任意, 設定した場合のみ Axiom へログ送信)
# AXIOM_TOKEN="xaat-..."
# AXIOM_DATASET="personal-apps"
