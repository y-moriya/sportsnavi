# Discord Webhook URL (必須)
WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"

# Gemini API Key (推奨: ローカルSQLiteによるインプロセス重複判定に使用)
GEMINI_API_KEY="AIzaSy..."

# 類似記事判定 API (任意: GEMINI_API_KEY 未設定時のフォールバック用)
# ECHO_BREAKER_URL="https://echo-breaker.euros21st.workers.dev/api/check-article"


# Discord 送信間隔 (ミリ秒, レートリミット保護, 任意, デフォルト: 1000 = 1秒)
NOTIFY_INTERVAL_MS=1000

# Axiom ログ送信 (任意, 設定した場合のみ Axiom へログ送信)
# AXIOM_TOKEN="xaat-..."
# AXIOM_DATASET="personal-apps"

# ログローテーション設定 (任意)
# MAX_LOG_SIZE_BYTES=5242880  # 1世代あたりの最大ファイルサイズ (バイト, デフォルト: 5MB = 5242880)
# MAX_LOG_FILES=3            # 保持するローテーション世代数 (デフォルト: 3世代)
# CRON_LOG_PATH="/path/to/sportsnavi/cron.log" # ログファイルパス (デフォルト: ./cron.log)

