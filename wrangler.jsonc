{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sportsnavi",
  "main": "src/main.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SPORTSNAVI_KV",
      "id": "f8a7258ce95a4b1c92a03d597a431e7a"
    }
  ],
  "services": [
    {
      "binding": "ECHO_BREAKER",
      "service": "echo-breaker"
    }
  ],
  "routes": [
    {
      "pattern": "sportsnavi.gunjobiyori.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "AXIOM_DATASET": "personal-apps"
  }
}
